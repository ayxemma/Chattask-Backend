# Required
OPENAI_API_KEY=your_key_here

# Optional: comma-separated browser origins (leave unset for no CORS / API-only clients)
# CORS_ORIGIN=https://your-frontend.example.com

# Optional OpenAI configuration (defaults shown)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_PARSE_MODEL=gpt-4o-mini

# Experimental SGLang parser (disabled by default — production keeps OpenAI)
# USE_SGLANG_PARSER=false
# SGLANG_BASE_URL=
# SGLANG_API_KEY=
# SGLANG_MODEL=

# Host port when running locally (Render/Railway set PORT automatically)
# PORT=3000
